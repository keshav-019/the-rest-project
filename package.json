{
    "name": "the-rest-project",
    "version": "0.1.0",
    "private": true,
    "homepage": "./",
    "main": "electron/main.js",
    "build": {
        "appId": "com.yourcompany.yourapp",
        "files": [
            "dist/**/*",
            "electron/**/*",
            "node_modules/**/*",
            "package.json"
        ],
        "directories": {
            "buildResources": "assets"
        }
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "build:dev": "next build",
        "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
        "electron:build": "next build && electron-builder",
        "electron:build:dir": "next build && next export -o dist && electron-builder --dir",
        "electron:start": "electron ."
    },
